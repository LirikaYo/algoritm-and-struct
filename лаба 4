void generateMass(int* arr, int size) {
    std::cout << "Генерация массива, размер 100000 элементов.";
    std::random_device rd;
    std::mt19937 gen(rd());
    std::uniform_int_distribution<int> dist(-2000000000, 2000000000);
    for (int i = 0; i < size; i++) {
        arr[i] = dist(gen);
    }
}

void deleteMass(int*& arr) {
    std::cout << "Массив удален.";
    delete[] arr;
    arr = nullptr;
}

void copyMass(int* arr1, int* arr2, int size) {
    for (int i = 0; i < size; i++) {
        arr2[i] = arr1[i];
    }
}

void sortOne(int* arr, int size) {
    for (int i = 0; i < size; i++) {
        bool swapped = false;
        for (int j = 0; j < size - i - 1; j++) {
            if (arr[j] > arr[j + 1]) {
                std::swap(arr[j], arr[j + 1]);
                swapped = true;
            }
        }
        if (!swapped) break;
    }
}

void sortTwo(int* arr, int size) {
    for (int i = 0; i < size - 1; i++) {
        int minId = i;
        for (int j = i + 1; j < size; j++) {
            if (arr[j] < arr[minId]) {
                minId = j;
            }
        }
        if (minId != i) {
            std::swap(arr[i], arr[minId]);
        }
    }
}

void sortThree(int* arr, int size) {
    for (int gap = size / 2; gap > 0; gap /= 2) {
        for (int i = gap; i < size; ++i) {
            int temp = arr[i];
            int j = i;

            while (j >= gap && arr[j - gap] > temp) {
                arr[j] = arr[j - gap];
                j -= gap;
            }
            arr[j] = temp;
        }
    }
}

void generateAscending(int* arr, int size) {
    for (int i = 0; i < size; i++) {
        arr[i] = i;
    }
}

void generateDescending(int* arr, int size) {
    for (int i = 0; i < size; i++) {
        arr[i] = size - i;
    }
}

void mainMenu() {
    const int size = 100000;
    int* data = new int[size];
    int* tempData = new int[size];
    int menu;
    bool ready = false;
    
    do {
        std::cout << "\n---Меню---" << std::endl;
        std::cout << "1. Создать массив." << std::endl;
        std::cout << "2. Сортировка Пузырьком." << std::endl;
        std::cout << "3. Сортировка Выбором." << std::endl;
        std::cout << "4. Сортировка Шелла." << std::endl;
        std::cout << "5. Генерация от 0 до 100000." << std::endl;
        std::cout << "6. Генерация от 100000 до 0." << std::endl;
        std::cout << "0. Выход." << std::endl;
        std::cout << "Выбери действие: ";
        std::cin >> menu;

        switch (menu) {
        case 1: {
            generateMass(data, size);
            ready = true;
            break;
        }
        case 2: {
            if (ready) {
                copyMass(data, tempData, size);
                auto start = std::chrono::high_resolution_clock::now();
                sortOne(tempData, size);
                auto end = std::chrono::high_resolution_clock::now();
                auto duration = std::chrono::duration_cast<std::chrono::microseconds>(end - start).count();
                std::cout << " Время сортировки: " << duration << " мкс." << std::endl;
            }
            else {
                std::cout << "Массив не сгенерирован." << std::endl;
            }

            break;
        }
        case 3: {
            if (ready) {
                copyMass(data, tempData, size);
                auto start = std::chrono::high_resolution_clock::now();
                sortTwo(tempData, size);
                auto end = std::chrono::high_resolution_clock::now();
                auto duration = std::chrono::duration_cast<std::chrono::microseconds>(end - start).count();
                std::cout << " Время сортировки: " << duration << " мкс." << std::endl;
            }
            else {
                std::cout << "Массив не сгенерирован." << std::endl;
            }

            break;
        }
        case 4: {
            if (ready) {
                copyMass(data, tempData, size);
                auto start = std::chrono::high_resolution_clock::now();
                sortThree(tempData, size);
                auto end = std::chrono::high_resolution_clock::now();
                auto duration = std::chrono::duration_cast<std::chrono::microseconds>(end - start).count();
                std::cout << " Время сортировки: " << duration << " мкс." << std::endl;
            }
            else {
                std::cout << "Массив не сгенерирован." << std::endl;
            }
            break;
        }
        case 5: {
            generateAscending(data, size);
            ready = true;
            std::cout << "Массив сгенерирован." << std::endl;
            break;
        }
        case 6: {
            generateDescending(data, size);
            ready = true;
            std::cout << "Массив сгенерирован." << std::endl;
            break;
        }
        case 0: {
            std::cout << "Выход из меню..." << std::endl;
            break;
        }
        default: {
            std::cout << "Неверный выбор." << std::endl;
        }
        }
    } while (menu != 0);
    deleteMass(data);
    deleteMass(tempData);
}


int main() {
    setlocale(LC_ALL, "RU");

    mainMenu();

    return 0;
}
